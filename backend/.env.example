# ==============================================================================
# Backend Environment Configuration Template (backend/.env)
# ==============================================================================

SECRET_KEY=change-this-to-a-secure-random-secret-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,nginx,backend
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Database (PostgreSQL)
POSTGRES_DB=stock_prediction
POSTGRES_USER=stock_admin
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CHANNEL_REDIS_URL=redis://localhost:6379/1

# Market Data Ingestion
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_SYMBOLS=TCS.NS,RELIANCE.NS,INFY.NS,HDFCBANK.NS
MARKET_DATA_INGEST_INTERVAL_SECONDS=300