# ==============================================================================
# Enterprise Stock Price Prediction Platform - Environment Configuration Template
# Copy this file to .env before starting the platform. NEVER commit the real .env!
# ==============================================================================

# Django Core Settings
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,nginx,backend
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# PostgreSQL Database Configuration
POSTGRES_DB=stock_prediction
POSTGRES_USER=stock_admin
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/1
REDIS_HOST_PORT=6379

# Market Data Ingestion & Live Pipeline
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_SYMBOLS=TCS.NS,INFY.NS,RELIANCE.NS,HDFCBANK.NS,ICICIBANK.NS,SBIN.NS,LT.NS,ITC.NS,BHARTIARTL.NS,AXISBANK.NS,KOTAKBANK.NS,HINDUNILVR.NS,MARUTI.NS,SUNPHARMA.NS
MARKET_DATA_INGEST_INTERVAL_SECONDS=300

# Nginx & Frontend Proxy Configuration
NGINX_PORT=8080
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=

# AI Market Intelligence Assistant Configuration
AI_PROVIDER=deterministic # Options: openai, deterministic, mock
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
AI_AGENT_RATE_LIMIT=30/m
